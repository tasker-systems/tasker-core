{
  "extends": "../../.conventions/baseline/typescript/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "bun-types"],
    "paths": {
      "#napi-generated": ["./index.d.ts"]
    }
  },
  "include": ["src/**/*", "index.d.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
